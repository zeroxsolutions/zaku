{
  "name": "@zeroxsolutions/zaku",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/entrypoints/cli/index.d.ts",
      "import": "./dist/entrypoints/cli/index.js",
      "default": "./dist/entrypoints/cli/index.js"
    },
    "./schema": {
      "types": "./dist/lib/schema/index.d.ts",
      "import": "./dist/lib/schema/index.js",
      "default": "./dist/lib/schema/index.js"
    },
    "./mcp": {
      "types": "./dist/entrypoints/mcp/index.d.ts",
      "import": "./dist/entrypoints/mcp/index.js",
      "default": "./dist/entrypoints/mcp/index.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@zeroxsolutions/cosmic": "0.3.4",
    "commander": "15.0.0",
    "reflect-metadata": "0.2.2",
    "tslib": "^2.3.0",
    "tsyringe": "4.10.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/ws": "8.18.2",
    "playwright": "1.64.0"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "...",
          "{workspaceRoot}/plugins/zaku/skills/building-the-library/references/figma.md"
        ]
      }
    }
  }
}
