{
  "name": "@zeroxsolutions/zaku-figma-plugin",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "zaku-figma-plugin",
    "targets": {
      "build-sandbox": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "platform": "browser",
          "target": "es2020",
          "format": [
            "esm"
          ],
          "bundle": true,
          "thirdParty": true,
          "main": "apps/zaku-figma-plugin/src/main.ts",
          "outputPath": "apps/zaku-figma-plugin/dist-sandbox",
          "outputFileName": "main.js",
          "tsConfig": "apps/zaku-figma-plugin/tsconfig.sandbox.json",
          "deleteOutputPath": true,
          "skipTypeCheck": true,
          "declaration": false,
          "minify": true
        }
      },
      "build-rules-script": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist-rules"
        ],
        "options": {
          "command": "esbuild apps/zaku-figma-plugin/src/rules-script.ts --bundle --minify --format=iife --global-name=zakuRulesLib --platform=browser --target=es2020 --outfile=apps/zaku-figma-plugin/dist-rules/rules.js --log-level=warning",
          "cwd": "{workspaceRoot}"
        }
      },
      "build": {
        "dependsOn": [
          "build-sandbox",
          "build-rules-script",
          "^build"
        ]
      }
    }
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.141.0",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.64.0",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3",
    "vitest-browser-react": "2.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@zeroxsolutions/zaku": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.0",
    "input-otp": "^1.5.0",
    "lucide-react": "1.60.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  }
}
