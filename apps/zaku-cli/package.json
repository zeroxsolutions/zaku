{
  "name": "@zeroxsolutions/zaku-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@zeroxsolutions/zaku": "workspace:*"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "target": "node22",
          "outputPath": "apps/zaku-cli/dist",
          "outputFileName": "zaku.mjs",
          "format": [
            "esm"
          ],
          "bundle": true,
          "thirdParty": true,
          "main": "apps/zaku-cli/src/main.ts",
          "tsConfig": "apps/zaku-cli/tsconfig.app.json",
          "external": [
            "playwright",
            "playwright-core"
          ],
          "esbuildOptions": {
            "banner": {
              "js": "import { createRequire as zakuCreateRequire } from 'node:module'; const require = zakuCreateRequire(import.meta.url);"
            },
            "outExtension": {
              ".js": ".mjs"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/zaku-cli/dist/package.json",
          "{workspaceRoot}/apps/zaku-cli/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/zaku-cli/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/zaku-cli/dist/patches",
          "{workspaceRoot}/apps/zaku-cli/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/zaku-cli/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@zeroxsolutions/zaku-cli:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@zeroxsolutions/zaku-cli:build:development"
          },
          "production": {
            "buildTarget": "@zeroxsolutions/zaku-cli:build:production"
          }
        }
      },
      "plugin-bin": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "outputs": [
          "{workspaceRoot}/plugins/zaku/bin/zaku.mjs"
        ],
        "options": {
          "command": "cp apps/zaku-cli/dist/zaku.mjs plugins/zaku/bin/zaku.mjs && pnpm exec oxfmt --write plugins/zaku/bin/zaku.mjs && chmod +x plugins/zaku/bin/zaku.mjs",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
