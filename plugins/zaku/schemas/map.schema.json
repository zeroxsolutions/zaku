{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "screens": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "default": false,
            "type": "boolean"
          },
          "states": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,-]*$"
            }
          },
          "targets": {
            "default": "all",
            "anyOf": [
              {
                "type": "string",
                "const": "all"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              }
            ]
          },
          "omits": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "copy-varies": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^([a-z][a-z0-9-]*\\/)?[a-z][a-z0-9-]*$"
                },
                "url": {
                  "type": "string",
                  "minLength": 1
                },
                "via": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "exits": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string",
                  "pattern": "^([a-z][a-z0-9-]*\\/)?[a-z][a-z0-9-]*$"
                },
                "via": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["to", "via"],
              "additionalProperties": false
            }
          },
          "back": {
            "default": {},
            "type": "object",
            "properties": {
              "web": {
                "type": "string"
              },
              "ios": {
                "type": "string"
              },
              "android": {
                "type": "string"
              },
              "macos": {
                "type": "string"
              },
              "windows": {
                "type": "string"
              },
              "gnome": {
                "type": "string"
              },
              "kde": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "components": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "a11y": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["title", "states"],
        "additionalProperties": false
      }
    }
  },
  "required": ["feature", "screens"],
  "additionalProperties": false
}
